<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>My Website</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f5f7fb;
      color: #222;
    }

    header {
      background: linear-gradient(135deg, #ff6b35, #ff9f1c);
      color: white;
      padding: 18px;
      text-align: center;
    }

    header h1 {
      font-size: 28px;
    }

    header p {
      margin-top: 8px;
      opacity: 0.9;
    }

    .hero {
      text-align: center;
      padding: 60px 20px;
    }

    .hero h2 {
      font-size: 32px;
      margin-bottom: 15px;
    }

    .hero p {
      color: #666;
      max-width: 600px;
      margin: auto;
      line-height: 1.6;
    }

    .btn {
      display: inline-block;
      margin-top: 25px;
      padding: 14px 28px;
      background: #ff6b35;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
    }

    .btn:hover {
      background: #e95522;
    }

    .services {
      padding: 30px 20px 60px;
      max-width: 1000px;
      margin: auto;
    }

    .services h2 {
      text-align: center;
      margin-bottom: 30px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      text-align: center;
    }

    .card h3 {
      margin-bottom: 12px;
      color: #ff6b35;
    }

    .card p {
      color: #666;
      line-height: 1.5;
    }

    footer {
      background: #222;
      color: white;
      text-align: center;
      padding: 20px;
    }
  </style>
</head>

<body>

  <header>
    <h1>Welcome To My Website</h1>
    <p>Modern • Simple • Professional</p>
  </header>

  <section class="hero">
    <h2>Hello! 👋</h2>
    <p>
      Welcome to my official website. Here you can explore my services,
      projects and latest updates.
    </p>

    <a href="#services" class="btn">Explore Now</a>
  </section>

  <section class="services" id="services">
    <h2>Our Services</h2>

    <div class="cards">

      <div class="card">
        <h3>🌐 Website</h3>
        <p>Modern and responsive website solutions.</p>
      </div>

      <div class="card">
        <h3>🤖 AI Tools</h3>
        <p>Explore powerful AI tools and technology.</p>
      </div>

      <div class="card">
        <h3>📱 Digital</h3>
        <p>Creative digital solutions for everyone.</p>
      </div>

    </div>
  </section>

  <footer>
    <p>© 2026 My Website | All Rights Reserved</p>
  </footer>

</body>
</html>
